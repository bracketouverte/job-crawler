# --- Database: Postgres primary, SQLite fallback ---
# When PG_HOST is set (default in docker-compose: postgres), viewer/crawler use Postgres.
# When PG_HOST is empty or Postgres unreachable and CATALOG_DRIVER=auto, they fall back to SQLite at CATALOG_DB.
CATALOG_DRIVER=auto
PG_HOST=postgres
PG_PORT=5432
PG_DB=job_catalog
PG_USER=job_admin
PG_PASSWORD=job_admin_password
# Optional: DATABASE_URL=postgres://job_admin:job_admin_password@postgres:5432/job_catalog

CAREER_OPS_DIR=career-ops
LOGO_DEV_PUBLISHABLE_KEY=pk_your_logo_dev_publishable_key_here
LOGO_DEV_SECRET_KEY=sk_your_logo_dev_secret_key_here
NVIDIA_API_KEY=nvapi_your_nvidia_api_key_here
NVIDIA_MODEL=google/gemma-4-e2b
NVIDIA_BASE_URL=http://127.0.0.1:1235
# Or set the full endpoint directly:
# NVIDIA_CHAT_COMPLETIONS_URL=http://127.0.0.1:1235/v1/chat/completions
NVIDIA_ENSEMBLE_SCORERS=google/gemma-4-e2b
NVIDIA_ENSEMBLE_SYNTHESIZER=google/gemma-4-e2b
NVIDIA_DEEPSEEK_REASONING_EFFORT=none
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
SCORE_NOTIFY_MIN_SCORE=4
JOB_TITLE_CONTAINS="product manager, program manager"

# --- Title pre-filter (System-1 gate before the LLM ensemble) ---
# Comma-separated target titles; incoming jobs whose titles don't match are
# skipped without an LLM call. Takes precedence over TARGET_TITLES_PATH.
# TARGET_TITLES="product manager, program manager, engineering manager"
# File fallback served from the viewer container (mounted public dir):
# TARGET_TITLES_PATH=/app/public/target-titles.json
# Laya sidecar endpoint (viewer -> title-filter service):
# TITLE_FILTER_URL=http://title-filter:8001/score
# Minimum Laya confidence to treat a mismatch as final (below -> LLM fallback):
TITLE_MATCH_MIN_CONFIDENCE=0.85
# Work-mode + region gate, comma-separated (mode_REGION). Empty disables.
# JOB_LOCATION_TYPE="remote_US, hybrid_US, onsite_US"
# Metro gate, comma-separated. Job location must contain one entry. Empty disables.
# JOB_LOCATION_METRO="chicago, los angeles"
# Salary gate. Job qualifies when the number is inside its [min, max] range.
# Blank disables. Supports "$120,000" / "120k" forms.
# SALARY="120000"
# Laya checkpoint (English default; multilingual upgrade: convaiinnovations/laya-multilingual via subfolder):
# LAYA_MODEL_REPO=convaiinnovations/laya
